# ==============================================================================
# PATH-AI — contoh konfigurasi
# Salin menjadi `.env` lalu isi nilainya. File `.env` tidak pernah di-commit.
# ==============================================================================

# --- Identitas layanan --------------------------------------------------------
# Port 8001 agar tidak bertabrakan dengan aplikasi PATH-AI lama (port 8000).
PATH_AI_PORT=8001

# --- Kunci akses --------------------------------------------------------------
# Kunci bersama server-ke-server. WAJIB diisi dan dipisah koma bila lebih
# dari satu; setiap kunci punya anggaran token sendiri.
#
# Buat yang acak, jangan diketik sendiri:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# JANGAN kirim kunci ini ke browser. Endpoint /health tidak butuh kredensial.
PATH_AI_API_KEYS=ganti-dengan-kunci-panjang-acak-1,ganti-dengan-kunci-panjang-acak-2

# --- Identitas pemakai --------------------------------------------------------
# TIDAK ADA variabel konfigurasi di sini. Layanan ini tidak mengurus akun;
# login, password, dan sesi sepenuhnya milik backend aplikasi Anda.
#
# Setiap permintaan dari backend mengirim dua header:
#
#   X-API-Key: <kunci di atas>          WAJIB
#   X-Actor-Id: guru:ani@sekolah.id     opsional
#   X-Actor-Id: siswa:budi@sekolah.id
#
# Awalannya WAJIB dan menentukan peran:
#   guru:   boleh semua fitur, anggaran PATH_AI_BUDGET_TOKENS_PER_DAY
#   siswa:  hanya /v1/materials/explain, anggaran pelajar di atas
# Awalan yang tidak dikenal DITOLAK (401), bukan ditebak sebagai pengajar.
#
# Email dinormalkan otomatis (huruf kecil, dipangkas), sehingga
# `guru:Ani@Sekolah.ID` dan `guru:ani@sekolah.id` adalah pemilik yang sama.
# Tanpa normalisasi, satu orang bisa punya dua anggaran dan job-nya
# "hilang" saat diakses lewat ejaan yang lain.
#
# Header ini diisi backend dari sesi login-nya sendiri. Browser TIDAK boleh
# menyentuhnya — karena itu header tersebut sengaja tidak ada di daftar
# header yang diizinkan CORS (lihat app/main.py). Kalau browser diizinkan,
# siapa pun yang sudah login bisa mengaku sebagai pelajar atau pengajar lain.
#
# Tanpa X-Actor-Id sama sekali, pemakaian menempel pada kunci (jalur curl dan
# panel admin). Tetapi header yang ADA tetapi tidak sah ditolak, bukan
# dimundurkan ke jalur admin.

# --- OpenRouter ---------------------------------------------------------------
# Satu kunci dipakai untuk model berbayar maupun model gratis.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PATH_AI_OPENROUTER_REFERER=https://path-ai.local
PATH_AI_OPENROUTER_TITLE=PATH-AI

# --- Model teks ---------------------------------------------------------------
# WAJIB. Sengaja tanpa nilai bawaan di kode: nilai yang salah tidak boleh
# diam-diam masuk produksi.
PATH_AI_MODEL=google/gemma-4-26b-a4b-it
# Kosongkan untuk menonaktifkan seluruh jalur gratis.
# Harus varian :free dari model yang sama agar gaya jawaban tidak melenceng.
PATH_AI_MODEL_FREE=google/gemma-4-26b-a4b-it:free

# --- Model gambar untuk ilustrasi --------------------------------------------
# Mode `kombinasi=true` memakai ini. Bila gagal, ilustrasi dilewati dan job
# tetap sukses. Kosongkan untuk mematikan ilustrasi sepenuhnya.
PATH_AI_MODEL_IMAGE=recraft/recraft-v4.1-flash-v2
PATH_AI_MAX_ILLUSTRATIONS=3

# --- Model penglihatan untuk halaman bergambar --------------------------------
# Dipakai membaca halaman yang berupa gambar: hasil pindai, foto halaman buku,
# dan foto lembar jawaban siswa. Tanpa ini, halaman bergambar dibaca memakai
# tesseract, yang harus dipasang di server lebih dulu.
#
# Biayanya dihitung per halaman, sekitar 0,0007 dolar untuk satu halaman pada
# model ini. Pilihan yang lebih murah: inclusionai/ling-3.0-flash-vl.
# Kosongkan untuk mematikan jalur ini dan kembali memakai tesseract sepenuhnya.
PATH_AI_MODEL_VISION=google/gemini-3.5-flash-lite

# Urutan pemakaian mesin pembaca halaman bergambar:
#   local = OCR lokal lebih dulu. Gratis dan memakai CPU server. Model
#           penglihatan hanya dipakai bila OCR lokal tidak tersedia. Tulisan
#           tangan dan foto miring hasilnya lebih kasar.
#   model = model penglihatan lebih dulu. Berbayar per halaman, tetapi CPU
#           server tetap lega.
PATH_AI_IMAGE_READER_ORDER=local

# --- Anggaran token -----------------------------------------------------------
# Batas token berbayar per kunci per hari (reset 00:00 UTC).
# Saat habis, hanya task non-kritikal yang turun ke model gratis.
PATH_AI_BUDGET_TOKENS_PER_DAY=200000

# Batas untuk pelajar, dipisah karena bentuk pemakaiannya berbeda:
# banyak pertanyaan kecil, bukan beberapa batch besar.
PATH_AI_STUDENT_BUDGET_TOKENS_PER_DAY=50000

# Batas ilustrasi per pelajar per hari.
PATH_AI_MAX_IMAGES_PER_STUDENT_PER_DAY=2

# Batas token per satu file jawaban siswa. File yang melebihi batas
# ditolak satu per satu; siswa lain dalam batch tetap diproses.
PATH_AI_MAX_TOKENS_PER_STUDENT=8000

# --- Bahan rujukan & ringkasan dokumen ---------------------------------------
# Batas teks bahan rujukan yang dikirim ke model untuk fitur 1 dan 2 (Tanya
# Materi dan Membuat Materi). Nilai ini dulu tertanam di kode sebesar 6000,
# dan akibatnya dokumen 39 halaman hanya terbaca sekitar seperenam: cukup
# untuk halaman judulnya, tidak untuk isinya.
PATH_AI_MAX_REFERENCE_TOKENS=30000

# Ringkasan dokumen panjang dibaca bertahap supaya seluruh isinya terbaca.
# Dokumen dipotong menjadi beberapa bagian, masing-masing diringkas, lalu
# ringkasannya digabung menjadi satu telaah.
PATH_AI_DOC_CHUNK_TOKENS=6000
PATH_AI_DOC_CHUNK_OVERLAP_TOKENS=200

# Batas jumlah bagian dokumen yang diproses. Sengaja longgar: 30 x 6000 token
# setara sekitar 175 halaman, sehingga untuk hampir semua berkas yang diunggah
# guru, yang menentukan bukan batas ini melainkan anggaran token. Turunkan
# nilai ini bila ingin membatasi biaya satu dokumen secara mutlak.
PATH_AI_DOC_MAX_CHUNKS=30

# Jumlah bagian yang diringkas bersamaan. Terlalu tinggi berisiko kena
# pembatasan laju dari penyedia model.
PATH_AI_DOC_CHUNK_CONCURRENCY=4

# --- Batas batch & file -------------------------------------------------------
PATH_AI_MAX_STUDENTS_PER_BATCH=100
PATH_AI_MAX_FILE_SIZE_MB=20
PATH_AI_MAX_ZIP_UNCOMPRESSED_MB=500
PATH_AI_ZIP_MAX_RATIO=100
PATH_AI_MAX_OCR_PAGES=20
PATH_AI_MAX_ANSWER_KEY_PAGES=20

# --- Ambang label nilai -------------------------------------------------------
# 86-100 Sangat Baik | 71-85 Baik | 56-70 Cukup | 0-55 Perlu Bimbingan
PATH_AI_LABEL_SANGAT_BAIK_MIN=86
PATH_AI_LABEL_BAIK_MIN=71
PATH_AI_LABEL_CUKUP_MIN=56

# --- Kemiripan jawaban (fitur 4) ----------------------------------------------
# Hanya pasangan di pita abu-abu ini yang dikirim ke LLM; sisanya deterministik.
PATH_AI_SIM_LLM_LOW=0.25
PATH_AI_SIM_LLM_HIGH=0.75
PATH_AI_SIM_LLM_MAX_PAIRS=3
PATH_AI_SIM_SHINGLE_SIZE=5

# --- Indikasi penggunaan AI (fitur 5) -----------------------------------------
# Skor heuristik < rendah = Rendah, > tinggi = Tinggi, sisanya dinilai LLM.
PATH_AI_AI_LOW=35
PATH_AI_AI_HIGH=65

# --- Job & sumber daya --------------------------------------------------------
# Job store ada di memori. WAJIB dijalankan dengan `--workers 1`.
# Direktori kerja job. Kosongkan untuk memakai ./jobs di dalam project.
PATH_AI_JOB_DIR=
PATH_AI_JOB_TTL_MINUTES=60
PATH_AI_MAX_CONCURRENT_JOBS=2

# Kunci jawaban hasil ekstraksi disimpan sementara agar guru bisa memeriksa
# sebelum dipakai menilai.
PATH_AI_ANSWER_KEY_TTL_MINUTES=30

# Jumlah jawaban siswa yang dinilai bersamaan. Terlalu tinggi berisiko
# kena pembatasan laju dari penyedia model.
PATH_AI_GRADE_CONCURRENCY=4

# --- Jaringan & retry ---------------------------------------------------------
PATH_AI_REQUEST_TIMEOUT=120
PATH_AI_MAX_RETRIES=2
PATH_AI_FREE_RATE_PER_MINUTE=20

# Ukuran maksimum satu request HTTP (mis. ZIP jawaban siswa).
PATH_AI_MAX_REQUEST_MB=50

# Origin frontend yang diizinkan, dipisah koma.
# Kosong berarti CORS dimatikan (hanya same-origin). Jangan pakai "*":
# itu membuat kunci API bisa dipanggil dari halaman mana pun.
PATH_AI_CORS_ORIGINS=http://localhost:5173

# --- OCR ----------------------------------------------------------------------
# Dipakai untuk membaca halaman yang berupa gambar: berkas hasil pindai, foto
# halaman buku, atau foto lembar jawaban siswa.
#
# Lokasi tesseract dicari otomatis, jadi biasanya TIDAK perlu diisi. PATH
# diperiksa lebih dulu, lalu lokasi pemasangan yang lazim: di Windows
# %LOCALAPPDATA%\Programs\Tesseract-OCR dan Program Files, di Linux /usr/bin
# dan /usr/local/bin. Isi baris ini hanya bila berkasnya ada di tempat lain:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#
# Di Windows, pemasangan lewat winget sudah cukup karena lokasinya termasuk
# yang dicari otomatis:
#   winget install --id UB-Mannheim.TesseractOCR -e --scope user
#
# Di dalam Docker (dipakai di VPS), tesseract beserta data bahasa Indonesia
# sudah ikut terpasang di image. Tidak ada yang perlu dilakukan di server.
#
# Bahasa yang dibutuhkan: ind dan eng. Kekurangannya dilaporkan saat menyala.
# Batas halaman yang diproses diatur PATH_AI_MAX_OCR_PAGES di bawah.
TESSERACT_CMD=

# --- Logging ------------------------------------------------------------------
PATH_AI_LOG_LEVEL=INFO